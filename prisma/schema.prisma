generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String?
  role            Role      @default(MEMBER)
  isActive        Boolean   @default(true)
  sessionVersion  Int       @default(0)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaigns          Campaign[]
  templates          Template[]
  sentInvitations    Invitation[]          @relation("InvitationInvitedBy")
  acceptedInvites    Invitation[]          @relation("InvitationAcceptedBy")
  memberships        WorkspaceMembership[]
  ownedWorkspaces    Workspace[]           @relation("WorkspaceOwner")
  emailVerifications EmailVerification[]
}

enum Role {
  ADMIN
  CAMPAIGN_MANAGER
  MEMBER
  VIEWER
}

model Workspace {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  ownerId              String
  owner                User          @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  plan                 Plan          @default(FREE)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  billingStatus        BillingStatus @default(ACTIVE)
  trialEndsAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  memberships  WorkspaceMembership[]
  invitations  Invitation[]
  campaigns    Campaign[]
  recipients   Recipient[]
  templates    Template[]
  segments     Segment[]
  deliveries   CampaignDelivery[]
  suppressions Suppression[]
  smtpSettings WorkspaceSmtpSettings?
  emailLogs    EmailLog[]

  @@index([ownerId])
}

model WorkspaceMembership {
  id             String    @id @default(cuid())
  workspaceId    String
  userId         String
  role           Role      @default(MEMBER)
  isActive       Boolean   @default(true)
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model StripeWebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

enum Plan {
  FREE
  STARTER
  GROWTH
  BUSINESS
}

enum BillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  name           String?
  role           Role
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String?
  invitedBy      User?            @relation("InvitationInvitedBy", fields: [invitedById], references: [id])
  acceptedUserId String?
  acceptedUser   User?            @relation("InvitationAcceptedBy", fields: [acceptedUserId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([email, token])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REJECTED
}

model Campaign {
  id              String         @id @default(cuid())
  name            String
  type            CampaignType
  subject         String?
  previewText     String?
  description     String?
  htmlContent     String?        @db.Text
  status          CampaignStatus @default(DRAFT)
  recipientMode   RecipientMode
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id])
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime?
  sendStartedAt   DateTime?
  sendCompletedAt DateTime?

  openTracking  Boolean @default(true)
  clickTracking Boolean @default(true)

  recipients CampaignRecipient[]
  links      CampaignLink[]
  events     TrackingEvent[]
  deliveries CampaignDelivery[]
  emailLogs  EmailLog[]

  @@index([workspaceId, createdAt])
}

enum CampaignType {
  ANNOUNCEMENT
  ACCOUNT_NOTICE
  PROMOTIONAL
  PRODUCT_UPDATE
  EDUCATIONAL
  URGENT_NOTICE
  OTHER
}

enum CampaignStatus {
  DRAFT
  READY
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RecipientMode {
  BULK
  SELECTED
}

model Recipient {
  id               String        @id @default(cuid())
  email            String
  firstName        String?
  lastName         String?
  customerId       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  workspaceId      String
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  consentStatus    ConsentStatus @default(UNKNOWN)
  consentSource    String?
  consentedAt      DateTime?
  unsubscribedAt   DateTime?
  unsubscribeToken String        @unique @default(cuid())
  customFields     Json?

  campaigns        CampaignRecipient[]
  CampaignDelivery CampaignDelivery[]

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

model CampaignRecipient {
  id          String     @id @default(cuid())
  campaignId  String
  recipientId String? // Nullable if BULK campaign level tracking
  campaign    Campaign   @relation(fields: [campaignId], references: [id])
  recipient   Recipient? @relation(fields: [recipientId], references: [id])

  trackingToken String @unique

  events   TrackingEvent[]
  delivery CampaignDelivery?
}

model CampaignLink {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id])
  originalUrl   String
  trackingToken String   @unique // URL-safe token representing this specific link in this campaign

  events TrackingEvent[]
}

model TrackingEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  campaignRecipientId String?
  campaignRecipient   CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id])

  campaignLinkId String?
  campaignLink   CampaignLink? @relation(fields: [campaignLinkId], references: [id])

  eventType  EventType
  timestamp  DateTime  @default(now())
  userAgent  String?
  ipHash     String?
  deviceInfo String?
  metadata   Json?

  @@index([campaignId, timestamp], map: "tracking_event_campaign_timestamp_idx")
  @@index([campaignId, eventType, campaignRecipientId], map: "tracking_event_campaign_recipient_idx")
  @@index([campaignId, eventType, campaignLinkId], map: "tracking_event_campaign_link_idx")
}

enum EventType {
  OPEN
  CLICK
}

model Template {
  id          String    @id @default(cuid())
  name        String
  description String?
  html        String
  category    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CampaignDelivery {
  id                  String            @id @default(cuid())
  workspaceId         String
  campaignId          String
  recipientId         String
  campaignRecipientId String            @unique
  status              DeliveryStatus    @default(QUEUED)
  attempts            Int               @default(0)
  nextAttemptAt       DateTime?
  lastError           String?
  providerMessageId   String?
  queuedAt            DateTime          @default(now())
  sentAt              DateTime?
  deliveredAt         DateTime?
  bouncedAt           DateTime?
  complainedAt        DateTime?
  unsubscribedAt      DateTime?
  updatedAt           DateTime          @updatedAt
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign            Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient           Recipient         @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  campaignRecipient   CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)
  emailLog            EmailLog?

  @@unique([campaignId, recipientId])
  @@index([workspaceId, status, nextAttemptAt])
  @@index([workspaceId, sentAt])
}

enum DeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  CANCELED
}

model Segment {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  definition  Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model Suppression {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  reason      String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  userId      String?
  details     Json?
  createdAt   DateTime @default(now())
  workspaceId String?
}

model WorkspaceSmtpSettings {
  workspaceId       String    @id
  host              String
  port              Int
  secure            Boolean   @default(false)
  username          String
  encryptedPassword String    @db.Text
  fromAddress       String
  replyTo           String?
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id           String            @id @default(cuid())
  workspaceId  String
  campaignId   String?
  deliveryId   String?           @unique
  kind         String
  campaignName String?
  toEmail      String
  subject      String
  fromAddress  String?
  replyTo      String?
  status       DeliveryStatus    @default(QUEUED)
  attempts     Int               @default(0)
  messageId    String?
  lastError    String?           @db.Text
  queuedAt     DateTime          @default(now())
  sentAt       DateTime?
  updatedAt    DateTime          @updatedAt
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign     Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  delivery     CampaignDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([workspaceId, queuedAt, id])
  @@index([workspaceId, kind, queuedAt])
  @@index([campaignId])
}
